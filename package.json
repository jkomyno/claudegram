{
  "private": true,
  "type": "module",
  "name": "claudegram-monorepo",
  "description": "Bidirectional bridge between Claude Code and Telegram. Monorepo.",
  "repository": "https://github.com/jkomyno/claudegram.git",
  "author": {
    "name": "Alberto Schiabel",
    "email": "alberto.schiabel@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "pnpm": ">=8"
  },
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo run build:watch",
    "check:exports": "turbo run check:exports",
    "clean": "turbo run clean",
    "lint:ci": "oxlint .",
    "lint": "oxlint --fix .",
    "test": "vitest --config ./vitest.config.ts run",
    "test:unit": "vitest --config ./vitest.config.ts --project unit run",
    "test:integration": "vitest --config ./vitest.config.ts --project integration run",
    "prepare": "is-ci || husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@types/node": "25.0.3",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "16.2.7",
    "rimraf": "6.1.2",
    "taze": "19.9.2",
    "tsdown": "0.18.3",
    "tsx": "4.21.0",
    "turbo": "2.7.2",
    "typescript": "5.9.3",
    "vitest": "4.0.16",
    "oxlint": "1.35.0"
  },
  "pre-commit": "lint-staged",
  "lint-staged": {
    "*.{js,ts,cjs,mjs}": "oxlint"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "@effect/cluster": "0.56.0",
      "@effect/experimental": "0.58.0",
      "@effect/platform-node-shared": "0.57.0",
      "@effect/rpc": "0.73.0",
      "@effect/sql": "0.49.0",
      "@effect/workflow": "0.16.0"
    }
  },
  "packageManager": "pnpm@10.26.2"
}

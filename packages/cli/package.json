{
  "private": false,
  "name": "claudegram",
  "version": "0.0.0",
  "description": "Bidirectional bridge between Claude Code and Telegram",
  "repository": "https://github.com/jkomyno/claudegram.git",
  "author": {
    "name": "Alberto Schiabel",
    "email": "alberto.schiabel@gmail.com"
  },
  "license": "MIT",
  "files": ["build", "bin"],
  "bin": {
    "claudegram": "./bin/claudegram.js",
    "cgm": "./bin/claudegram.js"
  },
  "main": "./build/bin.cjs",
  "types": "./build/bin.d.mts",
  "exports": {
    ".": {
      "import": {
        "@claudegram/source": "./src/bin.ts",
        "types": "./build/bin.d.mts",
        "default": "./build/bin.mjs"
      },
      "require": {
        "@claudegram/source": "./src/bin.ts",
        "types": "./build/bin.d.cts",
        "default": "./build/bin.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build .turbo",
    "build": "pnpm run build:js && pnpm run build:binary",
    "build:js": "tsdown --config ./tsdown.config.mts",
    "build:binary": "bun build ./src/bin.ts --compile --outfile ./build/claudegram",
    "build:watch": "pnpm build --watch",
    "check:exports": "attw --pack .",
    "test": "vitest --config ../../vitest.config.ts run",
    "test:unit": "vitest --config ../../vitest.config.ts --project unit run",
    "test:integration": "vitest --config ../../vitest.config.ts --project integration run"
  },
  "dependencies": {
    "@claudegram/core": "workspace:*",
    "@effect/cli": "0.73.0",
    "@effect/cluster": "0.56.0",
    "@effect/experimental": "0.58.0",
    "@effect/platform": "0.94.0",
    "@effect/platform-bun": "0.87.0",
    "@effect/rpc": "0.73.0",
    "@effect/sql": "0.49.0",
    "@effect/workflow": "0.16.0",
    "effect": "3.19.13"
  }
}

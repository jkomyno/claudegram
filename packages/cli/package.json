{
  "private": false,
  "name": "claudegram",
  "version": "0.0.0",
  "description": "Bidirectional bridge between Claude Code and Telegram",
  "repository": "https://github.com/jkomyno/claudegram.git",
  "author": {
    "name": "Alberto Schiabel",
    "email": "alberto.schiabel@gmail.com"
  },
  "license": "MIT",
  "files": ["build", "bin"],
  "bin": {
    "claudegram": "./bin/claudegram.js",
    "cgm": "./bin/claudegram.js"
  },
  "main": "./build/bin.js",
  "types": "./build/bin.d.ts",
  "exports": {
    ".": {
      "import": {
        "@claudegram/source": "./src/bin.ts",
        "types": "./build/bin.d.mts",
        "import": "./build/bin.mjs",
        "default": "./build/bin.mjs"
      },
      "require": {
        "@claudegram/source": "./src/bin.ts",
        "types": "./build/bin.d.ts",
        "import": "./build/bin.js",
        "default": "./build/bin.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build .turbo",
    "build": "tsup ./src/bin.ts --tsconfig ./tsconfig.build.json --config ../../tsup.config.ts",
    "build:watch": "pnpm build --watch",
    "check:exports": "attw --pack .",
    "test": "vitest --workspace ../../vitest.workspace.ts run",
    "test:unit": "vitest --workspace ../../vitest.workspace.ts --project unit run",
    "test:integration": "vitest --workspace ../../vitest.workspace.ts --project integration run"
  },
  "dependencies": {
    "@claudegram/core": "workspace:*",
    "@effect/cli": "0.73.0",
    "@effect/platform": "0.94.0",
    "@effect/platform-bun": "0.87.0",
    "effect": "3.19.13"
  }
}

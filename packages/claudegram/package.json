{
  "private": true,
  "name": "@claudegram/core",
  "version": "0.0.0",
  "description": "Core services and daemon for claudegram",
  "author": {
    "name": "Alberto Schiabel",
    "email": "alberto.schiabel@gmail.com"
  },
  "files": ["build"],
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "@claudegram/source": "./src/index.ts",
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "@claudegram/source": "./src/index.ts",
        "types": "./build/index.d.cts",
        "default": "./build/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf build .turbo",
    "build": "tsdown --config ./tsdown.config.mts",
    "build:watch": "pnpm build --watch",
    "check:exports": "attw --pack .",
    "test": "vitest --config ../../vitest.config.ts run",
    "test:unit": "vitest --config ../../vitest.config.ts --project unit run",
    "test:integration": "vitest --config ../../vitest.config.ts --project integration run"
  },
  "dependencies": {
    "effect": "3.19.13",
    "@effect/platform": "0.94.0"
  }
}
